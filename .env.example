# Copy to .env (scripts/dev-setup.ps1 does this and fills in random values).
# .env is gitignored. Never commit real secrets.

# PostgreSQL (one instance, one database per service: identity_db, catalog_db, order_db, payment_db)
POSTGRES_USER=pos
POSTGRES_PASSWORD=__GENERATED__
# Host port for PostgreSQL. Change it if you already run PostgreSQL on 5432.
POSTGRES_HOST_PORT=5432

# RabbitMQ (used from Phase 2)
RABBITMQ_USER=pos
RABBITMQ_PASSWORD=__GENERATED__

# JWT signing key shared by Identity (signs) and Gateway (validates). Minimum 32 characters.
JWT_SIGNING_KEY=__GENERATED__

# First admin account, created by Identity on startup only when no users exist.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=__GENERATED__
