# Copy to .env.local (scripts\dev-setup.ps1 does this). Values below are the local defaults.

# Where the Next.js server calls the API (server-side rendering). In Docker use http://gateway:5000
API_URL=http://localhost:5000

# Where the browser calls the API. Must be reachable from the phone or laptop that opens the menu.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Shown in the menu header. Optional logo: a full https URL.
NEXT_PUBLIC_RESTAURANT_NAME=My Restaurant
NEXT_PUBLIC_LOGO_URL=
