{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "pos-identity",
    "Audience": "pos-api"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 6291456
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/login"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "CorsPolicy": "frontend"
      },
      "identity-refresh": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/refresh"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "CorsPolicy": "frontend"
      },
      "identity-protected": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "orders-checkout": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/orders/checkout"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public-write",
        "CorsPolicy": "frontend"
      },
      "orders": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "payments-upload-slip": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/upload-slip"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public-write",
        "CorsPolicy": "frontend"
      },
      "payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "notification-hubs": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "catalog-write": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/products/{**rest}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH"
          ]
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "orders-list": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/orders"
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      },
      "orders-status": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/orders/{id}/status"
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "CorsPolicy": "frontend"
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "order": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5005/"
          }
        }
      }
    }
  }
}
